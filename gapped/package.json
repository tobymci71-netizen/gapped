{
  "name": "gapped",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/archivo": "^0.4.2",
    "@expo-google-fonts/inter": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "^8.19.0",
    "@shopify/flash-list": "^2.0.2",
    "@shopify/react-native-skia": "^2.6.2",
    "@supabase/supabase-js": "^2.110.8",
    "expo": "~57.0.7",
    "expo-blur": "~57.0.2",
    "expo-constants": "~57.0.6",
    "expo-file-system": "~57.0.1",
    "expo-font": "^57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.3",
    "expo-location": "~57.0.5",
    "expo-router": "~57.0.7",
    "expo-secure-store": "~57.0.1",
    "expo-sensors": "~57.0.2",
    "expo-sharing": "~57.0.6",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.5",
    "lottie-react-native": "~7.3.8",
    "posthog-react-native": "^4.58.0",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "^4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "^15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-view-shot": "^5.1.0",
    "react-native-worklets": "^0.10.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.1",
    "jest": "~29.7.0",
    "jest-expo": "^57.0.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "build:edge": "node scripts/build-edge-shared.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:studio": "open http://127.0.0.1:54423",
    "functions:serve": "supabase functions serve --env-file supabase/functions/.env",
    "verify:roundtrip": "node scripts/verify-roundtrip.mjs",
    "test:edge": "cd supabase/functions && deno test --allow-net --allow-read --allow-env _server/",
    "check:edge": "cd supabase/functions && deno check verify-drive/index.ts attest-device/index.ts decode-vin/index.ts",
    "lint": "expo lint",
    "verify:vin": "node scripts/verify-vin-decode.mjs"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg)"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts?(x)"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ]
  }
}
