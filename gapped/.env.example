# Copy to .env — all optional; the app runs fully offline without them.
# .env is gitignored. Never commit real keys.

# ── Supabase ────────────────────────────────────────────────────────────────
# Backend sync + auth. Two ways to fill these in:
#
# Local (no cloud account needed — needs Docker):
#   npm run db:start        # prints API_URL and ANON_KEY, applies migrations
#   npm run functions:serve # in a second terminal, for verify-drive
#
#   EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
#   EXPO_PUBLIC_SUPABASE_ANON_KEY=<ANON_KEY printed by db:start>
#
#   On a physical device, 127.0.0.1 is the phone. Use your Mac's LAN IP
#   (e.g. http://192.168.1.20:54421) — the local stack already binds 0.0.0.0.
#
# Cloud: create a project, `supabase link`, `supabase db push`, then take the
# URL and anon key from Project Settings → API.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ── Observability (Phase 1). Silent when unset. ─────────────────────────────
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=

# Sentry source-map upload (build time only, NOT EXPO_PUBLIC_ — these must not
# reach the bundle). Set in EAS as secrets: `eas env:create`.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
