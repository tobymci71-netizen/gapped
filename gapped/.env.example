# Copy to .env — all optional; the app runs fully offline without them.

# Supabase (backend sync + auth). Create a project, apply supabase/migrations/.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Observability (Phase 1). Silent when unset.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=
