# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
# `.env` itself must be listed: the README tells you to put your Supabase URL
# and anon key there, and `.env*.local` alone does not match it.
.env
.env*.local
!.env.example
supabase/functions/.env

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Release builds: archives, exported IPAs and symbols land in build/. Only the
# export options are source — they decide how an archive is uploaded.
/build/*
!/build/ExportOptions.plist
*.ipa
*.xcarchive
*.dSYM.zip
